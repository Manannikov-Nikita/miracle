# Copy to .local/runtime.env and change for production. Never commit credentials.
DATABASE_URL=postgres://miracle:miracle_local@127.0.0.1:5544/miracle
APP_ORIGIN=http://127.0.0.1:5178
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=3001
ENCRYPTION_KEY_FILE=.local/encryption.key
# Compose: set a strong POSTGRES_PASSWORD and use HTTPS with COOKIE_SECURE=true.
POSTGRES_PASSWORD=miracle_local
ENCRYPTION_KEY_PATH=./.local/encryption.key
