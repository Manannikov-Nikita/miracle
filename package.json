{
  "name": "miracle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1 --port 5178\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5178",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "start": "node dist/server/server/cli.js",
    "test": "vitest run",
    "test:integration": "tsx tests/integration.ts",
    "notices": "node scripts/dependency-notices.mjs",
    "release:bundle": "node scripts/build-release.mjs",
    "test:install": "node tests/local-install-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.6.0",
    "lossless-json": "^4.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/markdown": "^1.8.1",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.9.0",
    "concurrently": "^9.2.1",
    "decimal.js": "^10.6.0",
    "echarts": "^6.0.0",
    "jsdom": "^29.1.1",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "license": "Apache-2.0"
}
